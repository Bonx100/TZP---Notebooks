Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"suciastky", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"U1", "->", 
       RowBox[{"50.", "*", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}]}], ",", 
      RowBox[{"R1", "->", 
       RowBox[{"1.", "*", 
        SuperscriptBox["10", "3"]}]}], ",", 
      RowBox[{"R2", "->", 
       RowBox[{"100.", "*", 
        SuperscriptBox["10", "3"]}]}], ",", 
      RowBox[{"Aop", "->", 
       SuperscriptBox["10.", "5"]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rovnice", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"0", "==", 
      RowBox[{"Iz", "+", "Ir1"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Ir1", "==", "Ir2"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Ir2", "+", "Io"}], "==", "0"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Uz", "==", "U1"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U1", "-", "U2"}], "==", 
      RowBox[{"R1", "*", "Ir1"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U2", "-", "U3"}], "==", 
      RowBox[{"R2", "*", "Ir2"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"U3", "==", 
      RowBox[{"Aop", "*", 
       RowBox[{"(", 
        RowBox[{"UP", "-", "UN"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"UP", "==", "0"}], ",", "\[IndentingNewLine]", 
     RowBox[{"UN", "==", "U2"}]}], "\[IndentingNewLine]", "}"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"riesenie", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{"rovnice", "/.", "suciastky"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{

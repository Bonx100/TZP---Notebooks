Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"t", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", "*", "\[Pi]"}], ")"}], "/", "\[Omega]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u1", "=", 
   RowBox[{"10", "*", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"100", "*", "t"}], "+", "1.5"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u1f", "=", 
   RowBox[{"10", "+", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryJ]", "*", "1.5"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r1", "=", 
   RowBox[{"5", "*", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r2", "=", 
   RowBox[{"100", "*", 
    SuperscriptBox["10", "3"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"3", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l1", "=", 
   RowBox[{"10", "*", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l2", "=", 
    RowBox[{"3", "*", 
     SuperscriptBox["10", 
      RowBox[{"-", "6"}]]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zr1", "=", "r1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zr2", "=", "r2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zc", "=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"\[ImaginaryJ]", "*", "\[Omega]", "*", "c"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zl1", "=", 
   RowBox[{"\[ImaginaryJ]", "*", "\[Omega]", "*", "l1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zl2", "=", 
    RowBox[{"\[ImaginaryJ]", "*", "\[Omega]", "*", "l2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z1", "=", 
    FractionBox["1", 
     RowBox[{
      FractionBox["1", "zr1"], "+", 
      FractionBox["1", "zl1"]}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"z2", "=", 
    FractionBox["1", 
     RowBox[{
      FractionBox["1", "zr2"], "+", 
      FractionBox["1", "zl2"], "+", 
      FractionBox["1", "zc"]}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zin", "=", 
    RowBox[{"z2", "+", "z1"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", 
    FractionBox["z2", "zin"]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 

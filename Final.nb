Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u1", "=", "10"}], ";", 
  RowBox[{"u2", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"k1", "=", 
    RowBox[{"-", "5"}]}], ";", " ", 
   RowBox[{"k2", "=", 
    RowBox[{"-", "3"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r1", "=", "0.1"}], ";", 
  RowBox[{"r2", "=", "0.1"}], ";", 
  RowBox[{"r3", "=", "1000"}], ";", 
  RowBox[{"r4", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l1", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], ";", 
   RowBox[{"l2", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "3"}]]}], ";", 
   RowBox[{"c1", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], ";", 
   RowBox[{"c2", "=", 
    SuperscriptBox["10", 
     RowBox[{"-", "6"}]]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zr1", "=", "r1"}], ";", 
  RowBox[{"zr2", "=", "r2"}], ";", 
  RowBox[{"zr3", "=", "r3"}], ";", 
  RowBox[{"zr4", "=", "r4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zl1", "=", 
   RowBox[{"\[ImaginaryJ]", "*", "\[Omega]", "*", "l1"}]}], ";", " ", 
  RowBox[{"zl2", "=", 
   RowBox[{"\[ImaginaryJ]", "*", "\[Omega]", "*", "l2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zc1", "=", 
    FractionBox["1", 
     RowBox[{"\[ImaginaryJ]", "*", "\[Omega]", "*", "c1"}]]}], ";", 

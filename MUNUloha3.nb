Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"suciastky", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r1", "->", "10000"}], ",", 
     RowBox[{"r2", "->", "10000"}], ",", 
     RowBox[{"r3", "->", "1000000"}], ",", 
     RowBox[{"c1", "->", 
      RowBox[{"33", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}]}], ",", 
     RowBox[{"c2", "->", 
      RowBox[{"22", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amp", "=", "3.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", "917"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", 
   RowBox[{"5", "*", 
    RowBox[{"1", "/", "f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"uz", "[", "t_", "]"}], ":=", 
   RowBox[{"amp", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Tanh", "[", 
        RowBox[{"100", "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"2", "*", "Pi", "*", "f", "*", "t"}], "]"}]}], "]"}]}], 
      ")"}], "/", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rovnice", " ", "=", " ", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"iu", "[", "t", "]"}], "==", 
      RowBox[{"ir1", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ir1", "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"ic1", "[", "t", "]"}], "+", 
       RowBox[{"ir2", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ir2", "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"ic2", "[", "t", "]"}], "+", 
       RowBox[{"ir3", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"uz", "[", "t", "]"}], "==", 
      RowBox[{"u1", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"u1", "[", "t", "]"}], "-", 
       RowBox[{"u2", "[", "t", "]"}]}], "==", 
      RowBox[{"r1", "*", 
       RowBox[{"ir1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"u2", "[", "t", "]"}], "-", 
       RowBox[{"u3", "[", "t", "]"}]}], "==", 
      RowBox[{"r2", "*", 
       RowBox[{"ir2", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u3", "[", "t", "]"}], "==", 
      RowBox[{"r3", "*", 
       RowBox[{"ir3", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic1", "[", "t", "]"}], "==", 
      RowBox[{"c1", "*", 
       RowBox[{
        RowBox[{"u2", "'"}], "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"ic2", "[", "t", "]"}], "==", 
      RowBox[{"c2", "*", 
       RowBox[{
        RowBox[{"u3", "'"}], "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u2", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"u3", "[", "0", "]"}], "==", "0"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"premenne", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u1", "[", "t", "]"}], ",", 
     RowBox[{"u2", "[", "t", "]"}], ",", 
     RowBox[{"u3", "[", "t", "]"}], ",", 
     RowBox[{"iu", "[", "t", "]"}], ",", 
     RowBox[{"ir1", "[", "t", "]"}], ",", 
     RowBox[{"ir2", "[", "t", "]"}], ",", 
     RowBox[{"ir3", "[", "t", "]"}], ",", 
     RowBox[{"ic1", "[", "t", "]"}], ",", 
     RowBox[{"ic2", "[", "t", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"riesenie", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"rovnice", "/.", "suciastky"}], ",", "premenne", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"uz", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"u2", "[", "t", "]"}], "/.", "riesenie"}], ",", 
     RowBox[{
      RowBox[{"u3", "[", "t", "]"}], "/.", "riesenie"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Yellow", ",", "Green", ",", "Blue"}], "}"}]}], ",", 
   RowBox[{"Background", "->", "Black"}]}], "]"}]}], "Input",

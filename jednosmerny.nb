Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"suciastky", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r1", "->", "1"}], ",", 
     RowBox[{"r2", "->", "1"}], ",", 
     RowBox[{"c1", "->", "1"}], ",", 
     RowBox[{"c2", "->", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uz", "[", "t_", "]"}], ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rovnice", " ", "=", " ", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"0", "==", 
      RowBox[{
       RowBox[{"iu", "[", "t", "]"}], "+", 
       RowBox[{"ir1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ir1", "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"ic2", "[", "t", "]"}], "+", 
       RowBox[{"ic1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic2", "[", "t", "]"}], "==", 
      RowBox[{"ir2", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"uz", "[", "t", "]"}], "==", 
      RowBox[{"u1", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"u1", "[", "t", "]"}], "-", 
       RowBox[{"u2", "[", "t", "]"}]}], "==", 
      RowBox[{"r1", "*", 
       RowBox[{"ir1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u3", "[", "t", "]"}], "==", 
      RowBox[{"r2", "*", 
       RowBox[{"ir2", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ic1", "[", "t", "]"}], "==", 
      RowBox[{"c1", "*", 
       RowBox[{
        RowBox[{"u2", "'"}], "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"ic2", "[", "t", "]"}], "==", 
      RowBox[{"c2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"u2", "'"}], "[", "t", "]"}], "-", 
         RowBox[{
          RowBox[{"u3", "'"}], "[", "t", "]"}]}], ")"}]}]}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u2", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"u3", "[", "0", "]"}], "==", "0"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"premenne", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u1", "[", "t", "]"}], ",", 
     RowBox[{"u2", "[", "t", "]"}], ",", 
     RowBox[{"u3", "[", "t", "]"}], ",", 
     RowBox[{"iu", "[", "t", "]"}], ",", 
     RowBox[{"ir1", "[", "t", "]"}], ",", 
     RowBox[{"ir2", "[", "t", "]"}], ",", 
     RowBox[{"ic1", "[", "t", "]"}], ",", 
     RowBox[{"ic2", "[", "t", "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"riesenie", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"rovnice", "/.", "suciastky"}], ",", "premenne", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"uz", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"u2", "[", "t", "]"}], "/.", "riesenie"}], ",", 
     RowBox[{
      RowBox[{"u3", "[", "t", "]"}], "/.", "riesenie"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}]}], "Input",

Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"suciastky", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r1", "->", "3300"}], ",", 
     RowBox[{"r2", "->", "47000"}], ",", 
     RowBox[{"l", "->", 
      RowBox[{"22", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]]}]}], ",", 
     RowBox[{"c1", "->", 
      RowBox[{"39", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}]}], ",", 
     RowBox[{"c2", "->", 
      RowBox[{"82", "*", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"amp", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", 
   RowBox[{"5", "*", 
    RowBox[{"1", "/", "f"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uz", "[", "t_", "]"}], ":=", 
  RowBox[{"amp", "*", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{
      RowBox[{"Tanh", "[", 
       RowBox[{"100", "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", "Pi", "*", "f", "*", "t"}], "]"}]}], "]"}], "/", 
      "2"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rovnice", " ", "=", " ", "\[IndentingNewLine]", 
   RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"0", "==", 
      RowBox[{
       RowBox[{"il", "[", "t", "]"}], "+", 
       RowBox[{"ir1", "[", "t", "]"}], "+", 
       RowBox[{"ic1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ir1", "[", "t", "]"}], "+", 
       RowBox[{"il", "[", "t", "]"}]}], "==", 
      RowBox[{
       RowBox[{"ir2", "[", "t", "]"}], "+", 
       RowBox[{"iu", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"iu", "[", "t", "]"}], "+", 
       RowBox[{"ic2", "[", "t", "]"}]}], "==", "0"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"uz", "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"u2", "[", "t", "]"}], "-", 
       RowBox[{"u3", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"u1", "[", "t", "]"}], "-", 
       RowBox[{"u2", "[", "t", "]"}]}], "==", 
      RowBox[{"r1", "*", 
       RowBox[{"ir1", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"u2", "[", "t", "]"}], "==", 
      RowBox[{"r2", "*", 
       RowBox[{"ir2", "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"u1", "[", "t", "]"}], "-", 
       RowBox[{"u2", "[", "t", "]"}]}], "==", 
      RowBox[{"l", "*", 
       RowBox[{
        RowBox[{"il", "'"}], "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"ic1", "[", "t", "]"}], "==", 
      RowBox[{"c1", "*", 
       RowBox[{
        RowBox[{"u1", "'"}], "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"ic2", "[", "t", "]"}], "==", 
      RowBox[{"c2", "*", 
       RowBox[{
        RowBox[{"u3", "'"}], "[", "t", "]"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"il", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"u1", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"u3", "[", "0", "]"}], "==", "0"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"premenne", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u1", "[", "t", "]"}], ",", 
     RowBox[{"u2", "[", "t", "]"}], ",", 
     RowBox[{"u3", "[", "t", "]"}], ",", 
     RowBox[{"iu", "[", "t", "]"}], ",", 
     RowBox[{"ir1", "[", "t", "]"}], ",", 
     RowBox[{"ir2", "[", "t", "]"}], ",", 
     RowBox[{"ic1", "[", "t", "]"}], ",", 
     RowBox[{"ic2", "[", "t", "]"}], ",", 
     RowBox[{"il", "[", "t", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"riesenie", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"rovnice", "/.", "suciastky"}], ",", "premenne", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"uz", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"u3", "[", "t", "]"}], "/.", "riesenie"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
